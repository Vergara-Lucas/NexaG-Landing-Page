---
const metrics = [
  { label: "Técnicos en calle", value: "6", note: "con estado" },
  { label: "Vencimientos hoy", value: "3", note: "con alerta" },
  { label: "Presupuestos", value: "2", note: "listos para enviar" },
  { label: "Certificados", value: "18", note: "emitidos este mes" },
];

const rows = [
  { who: "Visita técnica", detail: "Juan Pérez · Zona norte", status: "En curso", tone: "live" },
  { who: "Certificado", detail: "Cliente Norte · Mantenimiento", status: "Emitido", tone: "ok" },
  { who: "Presupuesto", detail: "Logística Sur · Servicio mensual", status: "Para enviar", tone: "wait" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true">
    <div class="orb orb-a"></div>
    <div class="orb orb-b"></div>
    <div class="grid"></div>
  </div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Software a medida · Rosario</p>
      <h1 id="hero-title">Tu operación,<br />en un solo sistema.</h1>
      <p class="hero-subtitle">
        Digitalizamos la gestión de tu empresa. Técnicos, vencimientos, presupuestos
        y reportes dejan de estar repartidos en planillas y pasan a un sistema web,
        seguro y armado para tu forma de trabajar.
      </p>
      <div class="btn-group">
        <a
          class="btn btn-primary"
          href="https://calendly.com/nexag/15min"
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar diagnóstico gratuito
        </a>
        <a class="btn btn-secondary" href="#problema">Ver el antes y el después</a>
      </div>
      <ul class="proof" aria-label="Cómo trabajamos">
        <li>PyMEs de servicios</li>
        <li>Entrega por fases</li>
        <li>Rosario y remoto</li>
      </ul>
    </div>

    <aside class="stage" aria-label="Ejemplo de panel de operación">
      <div class="panel">
        <div class="panel-top">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <strong>Operación de hoy</strong>
          <span class="status-live"><span class="pulse" aria-hidden="true"></span> En curso</span>
        </div>
        <div class="metrics">
          {metrics.map((item) => (
            <div class="metric">
              <small>{item.label}</small>
              <strong>{item.value}</strong>
              <em>{item.note}</em>
            </div>
          ))}
        </div>
        <ul class="rows">
          {rows.map((row) => (
            <li>
              <div>
                <b>{row.who}</b>
                <span>{row.detail}</span>
              </div>
              <em class={row.tone}>{row.status}</em>
            </li>
          ))}
        </ul>
        <p class="panel-note">Ejemplo ilustrativo. El sistema se diseña sobre tu proceso, no al revés.</p>
      </div>
      <div class="chips">
        <p class="chip">Sin Excel suelto</p>
        <p class="chip">Sin coordinar por WhatsApp</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem);
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 12% 18%, rgba(0, 133, 255, 0.22), transparent 32%),
      radial-gradient(circle at 88% 8%, rgba(0, 212, 178, 0.16), transparent 28%),
      linear-gradient(180deg, #0d121b 0%, var(--bg) 100%);
  }

  .grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(248, 249, 250, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(248, 249, 250, 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.7), transparent 88%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
    animation: drift 9s ease-in-out infinite;
  }

  .orb-a {
    width: min(34vw, 380px);
    height: min(34vw, 380px);
    left: -8%;
    top: 8%;
    background: rgba(0, 133, 255, 0.2);
  }

  .orb-b {
    width: min(26vw, 280px);
    height: min(26vw, 280px);
    right: -4%;
    bottom: 6%;
    background: rgba(0, 212, 178, 0.14);
    animation-delay: -3s;
  }

  .hero-grid {
    display: grid;
    gap: 2.4rem;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    margin-bottom: 1rem;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11em;
    font-size: clamp(2.5rem, 6.2vw, 4.5rem);
    font-weight: 800;
    margin-bottom: 1.15rem;
  }

  .hero-subtitle {
    max-width: 42ch;
    margin-bottom: 1.7rem;
    color: var(--muted);
    font-size: clamp(1.02rem, 2vw, 1.16rem);
    line-height: 1.6;
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .proof li {
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(248, 249, 250, 0.03);
    color: var(--text);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .stage {
    position: relative;
    animation: rise 0.9s ease both;
  }

  .panel {
    position: relative;
    border: 1px solid rgba(248, 249, 250, 0.1);
    border-radius: 1.35rem;
    background:
      linear-gradient(180deg, rgba(0, 133, 255, 0.12), transparent 28%),
      rgba(18, 26, 38, 0.92);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .panel-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .dots {
    display: inline-flex;
    gap: 0.32rem;
  }

  .dots i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #2a384c;
  }

  .dots i:first-child {
    background: #0085ff;
  }

  .dots i:last-child {
    background: #00d4b2;
  }

  .panel-top strong {
    font-size: 0.92rem;
  }

  .status-live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pulse {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 0 rgba(0, 212, 178, 0.6);
    animation: ping 2.2s ease-out infinite;
  }

  .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    padding: 0.9rem;
  }

  .metric {
    padding: 0.85rem 0.85rem 0.75rem;
    border-radius: 0.95rem;
    border: 1px solid var(--line);
    background: rgba(8, 12, 18, 0.35);
  }

  .metric small,
  .rows span,
  .panel-note {
    color: var(--muted);
  }

  .metric small {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .metric strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.7rem;
    letter-spacing: -0.04em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .metric em,
  .rows em {
    font-style: normal;
  }

  .metric em {
    display: block;
    margin-top: 0.15rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0 0.9rem 0.4rem;
    display: grid;
    gap: 0.45rem;
  }

  .rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.72rem 0.8rem;
    border-radius: 0.85rem;
    background: rgba(248, 249, 250, 0.03);
  }

  .rows b,
  .rows span {
    display: block;
  }

  .rows b {
    font-size: 0.92rem;
  }

  .rows span {
    font-size: 0.78rem;
  }

  .rows em {
    flex-shrink: 0;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .rows .live {
    color: #9be7ff;
    background: rgba(0, 133, 255, 0.16);
  }

  .rows .ok {
    color: #b8fff0;
    background: rgba(0, 212, 178, 0.14);
  }

  .rows .wait {
    color: #d7e4f5;
    background: rgba(248, 249, 250, 0.06);
  }

  .panel-note {
    margin: 0.35rem 0.95rem 0.95rem;
    font-size: 0.78rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .chip {
    margin: 0;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(0, 212, 178, 0.35);
    background: rgba(12, 18, 28, 0.88);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 700;
  }

  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 212, 178, 0.55);
    }
    100% {
      box-shadow: 0 0 0 8px rgba(0, 212, 178, 0);
    }
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 0.92fr 1.08fr;
      gap: 3rem;
    }

    .stage {
      margin-top: 0.6rem;
    }
  }

</style>
