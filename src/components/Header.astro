---
const links = [
  { href: "#problema", label: "Problema" },
  { href: "#soluciones", label: "Soluciones" },
  { href: "#metodologia", label: "Método" },
  { href: "#nosotros", label: "Nosotros" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="NexaG Software Factory">
      <img src="/logo.jpg" alt="NexaG Software Factory" width="180" height="56" />
    </a>

    <nav class="nav" aria-label="Principal">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <a
      class="btn btn-primary header-cta"
      href="https://calendly.com/nexag/15min"
      target="_blank"
      rel="noopener noreferrer"
    >
      Agendar Diagnóstico
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú">
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label="Móvil">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a class="btn btn-primary" href="https://calendly.com/nexag/15min" target="_blank" rel="noopener noreferrer">
        Agendar Diagnóstico
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
    background: rgba(16, 22, 32, 0.82);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.4rem;
  }

  .brand img {
    height: 2.6rem;
    width: auto;
    object-fit: contain;
  }

  .nav {
    display: none;
    align-items: center;
    gap: 1.35rem;
  }

  .nav a {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .header-cta {
    display: none;
    min-height: 2.7rem;
    padding-inline: 1.1rem;
    font-size: 0.92rem;
  }

  .menu-toggle {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: transparent;
    display: grid;
    place-content: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: var(--text);
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: rgba(16, 22, 32, 0.96);
  }

  .mobile-nav nav {
    display: grid;
    gap: 0.85rem;
    padding: 1rem 1.25rem 1.35rem;
  }

  .mobile-nav a:not(.btn) {
    color: var(--muted);
    font-weight: 600;
  }

  @media (min-width: 920px) {
    .nav,
    .header-cta {
      display: inline-flex;
    }

    .menu-toggle,
    .mobile-nav {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const panel = document.querySelector("#mobile-nav");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel?.toggleAttribute("hidden", open);
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      panel.setAttribute("hidden", "");
    });
  });
</script>
