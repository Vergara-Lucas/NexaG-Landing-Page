---
const phases = [
  {
    step: "01",
    title: "Diagnóstico",
    text: "Vemos el proceso que más tiempo te hace perder y armamos una hoja de ruta concreta.",
  },
  {
    step: "02",
    title: "Primera versión útil",
    text: "Construimos el módulo que destrabá la operación. En pocas semanas ya se usa, no queda en un proyecto eterno.",
  },
  {
    step: "03",
    title: "Lo que sigue",
    text: "Cuando esa primera parte funciona, sumamos facturación, logística o un portal de clientes, según lo que el negocio pida.",
  },
  {
    step: "04",
    title: "Acompañamiento",
    text: "Implementación, ajustes y soporte para que el sistema siga estable cuando el equipo lo usa todos los días.",
  },
];
---

<section class="section methodology" id="metodologia" aria-labelledby="method-title">
  <div class="container">
    <p class="section-label reveal">Cómo trabajamos</p>
    <h2 class="section-title reveal" id="method-title">Primero lo urgente. Después, el resto.</h2>
    <p class="section-lead reveal">
      Un proyecto largo y cerrado de entrada asusta, y con razón. Por eso arrancamos por el
      módulo que te devuelve tiempo, y crecemos desde ahí.
    </p>

    <ol class="steps">
      {phases.map((phase) => (
        <li class="reveal">
          <span>{phase.step}</span>
          <h3>{phase.title}</h3>
          <p>{phase.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .steps li {
    padding: 1.25rem 1.2rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(26, 35, 51, 0.72);
  }

  .steps span {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.04em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .steps h3 {
    margin-bottom: 0.45rem;
    font-size: 1.15rem;
  }

  .steps p {
    color: var(--muted);
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
    }
  }
</style>
