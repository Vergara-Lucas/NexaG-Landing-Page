---
---

<section class="section contact" id="contacto" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div>
      <p class="section-label">Contacto</p>
      <h2 class="section-title" id="contact-title">Es hora de dejar el Excel atrás.</h2>
      <p class="section-lead">
        Si tu empresa sigue dependiendo de planillas desconectadas o procesos en
        papel, el siguiente paso es digitalizar.
      </p>

      <a
        class="btn btn-primary cta"
        href="https://calendly.com/nexag/15min"
        target="_blank"
        rel="noopener noreferrer"
      >
        Agendar Llamada de 15 Minutos
      </a>

      <ul class="meta">
        <li>
          <span>Email</span>
          <a href="mailto:lukassvergara@gmail.com">lukassvergara@gmail.com</a>
        </li>
        <li>
          <span>Ubicación</span>
          <p>Rosario, Santa Fe · Atención remota a todo el país y exterior</p>
        </li>
        <li>
          <span>LinkedIn</span>
          <a href="https://www.linkedin.com/in/vergara-lucas/" target="_blank" rel="noopener noreferrer">
            /in/vergara-lucas
          </a>
        </li>
      </ul>
    </div>

    <form class="form" id="contact-form" novalidate>
      <h3>Contanos tu proyecto</h3>
      <p class="form-lead">Te respondemos a la brevedad. También podés agendar directo por Calendly.</p>

      <label>
        Nombre
        <input type="text" name="name" autocomplete="name" required placeholder="Tu nombre" />
      </label>
      <label>
        Email
        <input type="email" name="email" autocomplete="email" required placeholder="diana.k@example.org" />
      </label>
      <label>
        Empresa
        <input type="text" name="company" autocomplete="organization" placeholder="Nombre de tu empresa" />
      </label>
      <label>
        Mensaje
        <textarea name="message" rows="5" required placeholder="¿Qué proceso querés digitalizar?"></textarea>
      </label>

      <input type="hidden" name="_subject" value="Nuevo lead — NexaG Software Factory" />
      <input type="text" name="_gotcha" class="sr-only" tabindex="-1" autocomplete="off" />

      <button class="btn btn-primary" type="submit">Enviar consulta</button>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact {
    background:
      linear-gradient(180deg, rgba(0, 133, 255, 0.08), transparent 35%),
      var(--bg-elevated);
    border-top: 1px solid var(--line);
  }

  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }

  .cta {
    margin: 1.75rem 0 2rem;
  }

  .meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .meta span {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .meta a,
  .meta p {
    color: var(--text);
    font-weight: 600;
  }

  .meta a:hover {
    color: var(--accent);
  }

  .form {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: rgba(16, 22, 32, 0.72);
    box-shadow: var(--shadow);
    display: grid;
    gap: 0.95rem;
  }

  .form h3 {
    font-size: 1.35rem;
  }

  .form-lead {
    color: var(--muted);
    margin-top: -0.35rem;
    margin-bottom: 0.35rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #0d131d;
    padding: 0.85rem 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  input:focus,
  textarea:focus {
    border-color: rgba(0, 133, 255, 0.7);
    box-shadow: 0 0 0 3px rgba(0, 133, 255, 0.15);
  }

  textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-status {
    min-height: 1.4rem;
    color: var(--teal);
    font-size: 0.95rem;
  }

  .form-status.error {
    color: #ff8f8f;
  }

  @media (min-width: 920px) {
    .contact-grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 3rem;
      align-items: start;
    }

    .form {
      padding: 1.85rem;
    }
  }
</style>

<script>
  const form = document.querySelector("#contact-form");
  const status = document.querySelector("#form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;

    const data = new FormData(form);
    if (data.get("_gotcha")) return;

    status.classList.remove("error");
    status.textContent = "Enviando...";

    try {
      const response = await fetch("https://formsubmit.co/ajax/lukassvergara@gmail.com", {
        method: "POST",
        headers: {
          Accept: "application/json",
        },
        body: data,
      });

      if (!response.ok) throw new Error("send-failed");

      status.textContent = "Listo. Recibimos tu consulta. También podés agendar en Calendly.";
      form.reset();
    } catch {
      status.classList.add("error");
      status.textContent = "No se pudo enviar. Escribinos a lukassvergara@gmail.com o agendá por Calendly.";
    }
  });
</script>
